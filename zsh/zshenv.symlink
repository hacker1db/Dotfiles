export DOTFILES="${${(%):-%N}:A:h:h}"
export CACHEDIR="$HOME/.local/share"
export VIM_TMP="$HOME/.vim-tmp"
# add a config file for ripgrep
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
# Default Claude Code profile; bin/claude-foundry and bin/claude-subscription override it per launch.
export CLAUDE_CONFIG_DIR="$HOME/.claude-personal"

[[ -d "$CACHEDIR" ]] || mkdir -p "$CACHEDIR"
[[ -d "$VIM_TMP" ]] || mkdir -p "$VIM_TMP"

for _op_sock in ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock ~/.1password/agent.sock; do
    [[ -S $_op_sock ]] && { export SSH_AUTH_SOCK=$_op_sock; break; }
done
unset _op_sock

[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local

source "$DOTFILES/zsh/fpath"

typeset -aU path


## Only source this if it exsits
FILE="$HOME/.config/op/plugins.sh"
test -f $FILE && source "$FILE"
export EDITOR='nvim'
export GIT_EDITOR='nvim'
# export OPENAI_API_KEY=$(op item get "OpenAI API Key" | jq -r '.details.sections[0].fields[0].value')
