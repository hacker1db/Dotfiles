{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-command.sh\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v ggshield >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || exit 0; jq -c 'if ((.transcript_path // \"\") | test(\"claude\")) then . else with_entries(select(.key | IN(\"hook_event_name\", \"session_id\", \"timestamp\", \"cwd\", \"prompt\", \"tool_name\", \"tool_input\", \"tool_result\"))) end' | ggshield secret scan ai-hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH\"; if command -v rtk >/dev/null 2>&1; then out=$(rtk hook claude) || exit $?; [ -z \"$out\" ] || printf %s \"$out\" | jq -c 'if .hookSpecificOutput.permissionDecision? == \"allow\" then del(.hookSpecificOutput.permissionDecision) else . end'; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-notify waiting \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}' 2>/dev/null)\" \"$TMUX_PANE\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-notify completed \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}' 2>/dev/null)\" \"$TMUX_PANE\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-cleanup",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v ggshield >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || exit 0; jq -c 'if ((.transcript_path // \"\") | test(\"claude\")) then . else with_entries(select(.key | IN(\"hook_event_name\", \"session_id\", \"timestamp\", \"cwd\", \"prompt\", \"tool_name\", \"tool_input\", \"tool_result\"))) end' | ggshield secret scan ai-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v ggshield >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || exit 0; jq -c 'if ((.transcript_path // \"\") | test(\"claude\")) then . else with_entries(select(.key | IN(\"hook_event_name\", \"session_id\", \"timestamp\", \"cwd\", \"prompt\", \"tool_name\", \"tool_input\", \"tool_result\"))) end' | ggshield secret scan ai-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "fleet@fleet-local": true,
    "cli-anything@cli-anything": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cli-anything": {
      "source": {
        "source": "github",
        "repo": "HKUDS/CLI-Anything",
        "ref": "34f519533bc175d2fe287ab8316b0dd99bb9cc43"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "enabledMcpjsonServers": ["github", "playwright"],
  "plansDirectory": "~/notes/SecondBrain/4.Resources/plans",
  "effortLevel": "high",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "outputStyle": "Plan Manager",
  "tui": "fullscreen",
  "model": "claude-fable-5[1m]",
  "skillListingBudgetFraction": 0.02,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(wt list)",
      "Bash(wt list *)",
      "Bash(wt switch -c *)",
      "Bash(wt switch --create *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(shred *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(fdisk*)",
      "Bash(diskutil erase*)",
      "Bash(diskutil unmount*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/op/**)",
      "Read(~/.localrc)",
      "Read(~/.config/foundry-entra-proxy/client.key)",
      "Edit(~/.localrc)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo fork *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh auth *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label delete *)",
      "Bash(gh label clone *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(wt switch *-x *)",
      "Bash(wt switch *--execute*)",
      "Bash(op *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(~/notes/SecondBrain/**)",
      "Edit(~/.git-templates/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
