{
  "mcpServers": {
"playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN_MCP}",
        "X-MCP-Toolsets": "default,copilot_spaces"
      }
    }
  }
}
