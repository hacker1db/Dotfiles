#!/usr/bin/env bash

# gh-pr-review: Check out a PR into a review worktree and open in a tmux "reviews" session
#
# Usage: gh-pr-review <pr-number> <repo-owner> <repo-name> <repo-path>
#
# Called from gh-dash keybindings:
#   command: "gh-pr-review {{.PrNumber}} {{.RepoOwner}} {{.RepoName}} {{.RepoPath}}"
#
# {{.RepoPath}} requires repoPaths to be configured in gh-dash config.yml

PR_NUMBER="${1:?Usage: gh-pr-review <pr-number> <repo-owner> <repo-name> <repo-path>}"
REPO_OWNER="${2:?repo-owner required}"
REPO_NAME="${3:?repo-name required}"
REPO_PATH="${4:?repo-path required — configure repoPaths in gh-dash config.yml}"

WORKTREE_NAME="review-${PR_NUMBER}"
WORKTREE_PATH="${REPO_PATH}/${WORKTREE_NAME}"
SESSION="reviews"
WINDOW_NAME="pr-${PR_NUMBER}"

notify() {
  tmux display-message -d 4000 "$1" 2>/dev/null || true
}

# Fetch PR branch name
PR_BRANCH=$(gh pr view "$PR_NUMBER" --repo "${REPO_OWNER}/${REPO_NAME}" --json headRefName -q '.headRefName' 2>&1)
if [[ $? -ne 0 || -z "$PR_BRANCH" ]]; then
  notify "gh-pr-review: failed to fetch PR #${PR_NUMBER} — ${PR_BRANCH}"
  exit 1
fi

# Fetch branch from origin
git -C "$REPO_PATH" fetch origin "$PR_BRANCH" 2>/dev/null || true

# Create worktree if it doesn't exist
if [[ ! -d "$WORKTREE_PATH" ]]; then
  git -C "$REPO_PATH" worktree add "$WORKTREE_PATH" "origin/${PR_BRANCH}" 2>/dev/null \
  || git -C "$REPO_PATH" worktree add "$WORKTREE_PATH" "$PR_BRANCH" 2>/dev/null \
  || git -C "$REPO_PATH" worktree add -b "${WORKTREE_NAME}" "$WORKTREE_PATH" "origin/${PR_BRANCH}" 2>/dev/null
  if [[ $? -ne 0 ]]; then
    notify "gh-pr-review: failed to create worktree ${WORKTREE_NAME}"
    exit 1
  fi
fi

# Create session if it doesn't exist
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux new-session -d -s "$SESSION" -c "$WORKTREE_PATH" -n "$WINDOW_NAME"
else
  # Add window if it doesn't already exist in the session
  if ! tmux list-windows -t "$SESSION" -F "#{window_name}" 2>/dev/null | grep -qx "$WINDOW_NAME"; then
    tmux new-window -t "$SESSION" -c "$WORKTREE_PATH" -n "$WINDOW_NAME"
  fi
fi

notify "✓ review-${PR_NUMBER} ready — switching to 'reviews' session"

# Switch client to the reviews session (works from within a tmux popup)
tmux switch-client -t "${SESSION}:${WINDOW_NAME}" 2>/dev/null \
|| tmux switch-client -t "$SESSION" 2>/dev/null \
|| true
