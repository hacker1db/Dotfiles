#!/usr/bin/env zsh
emulate -L zsh
zmodload zsh/stat zsh/datetime

cache="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-pr-chip"
ttl="${TMUX_PR_CHIP_TTL:-300}"
mkdir -p "${cache:h}"

refresh() {
    local count
    count="$(gh search prs --review-requested @me --state open --json number --limit 100 --jq length 2>/dev/null)" || return
    [[ "$count" == <-> ]] && print -r -- "$count" > "$cache.tmp" && mv -f "$cache.tmp" "$cache"
}

if (( $+commands[gh] )) && { [[ ! -f "$cache" ]] || (( EPOCHSECONDS - $(zstat +mtime "$cache") > ttl )); }; then
    touch "$cache"
    refresh &!
fi

count="$(< "$cache" 2>/dev/null)"
if [[ "$count" == <-> ]] && (( count > 0 )); then
    print -rn -- "#[range=user|prs]#[fg=#f1fc79] ${count} PRs#[norange]"
fi

plan_bin="${commands[plan]:-$HOME/.local/bin/plan}"
if [[ -x "$plan_bin" ]] && command -v jq &> /dev/null; then
    plans="$("$plan_bin" list --status active --json 2>/dev/null | jq '.plans | length' 2>/dev/null)"
    [[ "$plans" == <-> ]] && (( plans > 0 )) && print -rn -- " #[range=user|plans]#[fg=#04d1f9]${plans} plans#[norange]"
fi
