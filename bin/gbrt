#!/usr/bin/env ruby

def format_commit_info timestamp, time_desc, commit_id, message, ref_name
  [
    "#{timestamp.strftime("%y %b %d")}, #{timestamp.strftime("%l:%M%p").downcase}",
    "(#{time_desc})",
    commit_id,
    message,
    ref_name
  ]
end

def render_commit_info timestamp, time_desc, commit_id, message, ref_name, merged
  [
    timestamp,
    time_desc,
    "\e[32m#{ref_name}\e[0m",
    (merged ? "  #{commit_id}" : "+ \e[33m#{commit_id}\e[0m"),
    "\e[#{message[/^Temp/] ? 31 : 90}m#{message.strip}\e[0m"
  ].join(' ')
end

commit_info = IO.popen(['git', 'branch', '--format=%(refname)%00%(symref)%00%(refname:short)', *ARGV], &:read).split("\n").map {|line|
  line.split("\0", 3)
}.select {|refname, symref, _|
  refname.to_s.start_with?('refs/') && symref.to_s.empty?
}.map {|_, _, ref_name|
  ref_name
}.map {|ref_name|
  IO.popen(['git', 'log', '--no-walk', '--pretty=format:%ct%x1f%cr%x1f%h%x1f%s', '--end-of-options', ref_name, '--'], &:read).strip.split("\x1f", 4).map {|field|
    field.gsub(/[[:cntrl:]]/, '')
  }.push(ref_name)
}.map {|commit_info|
  [Time.at(commit_info.shift.to_i)].concat(commit_info)
}.sort_by {|commit_info|
  commit_info.first # unix timestamp
}.reverse.map {|commit_info|
  format_commit_info(*commit_info)
}.transpose.map {|column|
  max_col_length = column.sort_by {|i| i.length }.last.length
  column.map {|i| i.ljust(max_col_length) }
}.transpose.map {|commit_info|
  commit_info.push(
    IO.popen(['git', 'merge-base', '--end-of-options', 'HEAD', commit_info[2].strip], &:read).chomp[0...7] == commit_info[2]
  )
}.each {|commit_info|
  puts render_commit_info(*commit_info)
}
