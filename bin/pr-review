#!/usr/bin/env zsh
set -euo pipefail

(( $# <= 1 )) || { print -u2 "Usage: ${0:t} [pr-number | pr-url]"; exit 2 }
command -v nvim >/dev/null 2>&1 || { print -u2 "nvim is not installed"; exit 1 }
command -v gh >/dev/null 2>&1 || { print -u2 "gh is not installed"; exit 1 }

if (( $# == 0 )); then
    exec nvim "+PrDashboard"
elif [[ "$1" == <-> ]]; then
    exec nvim "+Octo pr edit $1"
else
    exec nvim "+Octo $1"
fi
