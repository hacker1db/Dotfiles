#!/usr/bin/env zsh
set -euo pipefail

usage() {
    print -u2 "Usage: dotfiles-relocate [--dry-run] [from] [to]"
    print -u2 "Moves the bare dotfiles repository (default ~/.dotfiles to ~/Developer/dotfiles),"
    print -u2 "repairs its worktrees, and repoints every symlink into it at the same checkout."
    exit 1
}

dry_run=0
typeset -a positional=()
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) dry_run=1 ;;
        -h|--help) usage ;;
        -*) usage ;;
        *) positional+=("$arg") ;;
    esac
done
(( ${#positional} <= 2 )) || usage
old="${${positional[1]:-$HOME/.dotfiles}:a}"
new="${${positional[2]:-$HOME/Developer/dotfiles}:a}"

[[ -d "$old/.bare" ]] || { print -u2 "No bare repository at $old/.bare"; exit 1; }
[[ ! -e "$new" && ! -L "$new" ]] || { print -u2 "$new already exists"; exit 1; }
[[ "$new/" != "$old/"* ]] || { print -u2 "$new is inside $old"; exit 1; }

run() {
    if (( dry_run )); then
        print -r -- "would run: ${(q-)@}"
    else
        "$@"
    fi
}

typeset -a links=() link_targets=()
while IFS= read -r -d '' link; do
    target="$(readlink "$link")"
    [[ "$target" == "$old" || "$target" == "$old/"* ]] || continue
    links+=("$link")
    link_targets+=("$new${target#$old}")
done < <(find "$HOME" -xdev -maxdepth 6 \
    \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -path "$old" -o -name node_modules -o -name .git \) -prune \
    -o -type l -print0 2>/dev/null)

typeset -a worktrees=()
while IFS= read -r line; do
    [[ "$line" == worktree\ * ]] || continue
    wt_path="${line#worktree }"
    [[ "$wt_path" == "$old/.bare" ]] && continue
    [[ "$wt_path" == "$old/"* ]] && wt_path="$new${wt_path#$old}"
    worktrees+=("$wt_path")
done < <(git --git-dir="$old/.bare" worktree list --porcelain)

selected=""
if [[ -L "$HOME/.zshrc" ]]; then
    selected="$(readlink "$HOME/.zshrc")"
    selected="${selected%/zsh/zshrc.symlink}"
    [[ "$selected" == "$old/"* ]] && selected="$new${selected#$old}"
fi

print "Moving $old -> $new"
print "Worktrees to repair: ${#worktrees}"
print "Symlinks to repoint: ${#links}"
[[ -n "$selected" ]] && print "Selected checkout after the move: $selected"
(( dry_run )) && for (( i = 1; i <= ${#links}; i++ )); do print -r -- "  ${links[i]} -> ${link_targets[i]}"; done

run mkdir -p "${new:h}"
run mv "$old" "$new"
(( ${#worktrees} )) && run git --git-dir="$new/.bare" worktree repair "${worktrees[@]}"
for (( i = 1; i <= ${#links}; i++ )); do
    run ln -sfn "${link_targets[i]}" "${links[i]}"
done

old_key="${old//[^A-Za-z0-9]/-}"
new_key="${new//[^A-Za-z0-9]/-}"
for project in "$HOME"/.claude*/projects/"$old_key"*(N/); do
    destination="${project:h}/$new_key${${project:t}#$old_key}"
    [[ -e "$destination" ]] && continue
    run cp -R "$project" "$destination"
done

typeset -a mentions=()
for file in "$HOME/.localrc" "$HOME/.gitconfig-local" "$HOME/.config/git/config" "$HOME/.codex/config.toml"; do
    [[ -f "$file" ]] && grep -qF -- "$old" "$file" && mentions+=("$file")
done
if (( ${#mentions} )); then
    print "\nThese machine-local files still mention $old; update them by hand:"
    print -l -- "  "${^mentions}
fi
print "\nUpdate this machine's hacker1db/Dotfiles path in fleet-manager's fleet.json to ${new/#$HOME/~}."

(( dry_run )) && exit 0
print "Done. Reload open shells with: exec zsh"
if [[ -n "$selected" && -d "$selected" && -t 0 && -t 1 ]]; then
    cd "$selected"
    exec zsh -i
fi
