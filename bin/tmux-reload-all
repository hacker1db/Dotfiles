#!/usr/bin/env zsh
set -euo pipefail

CONFIG="${HOME}/.config/tmux/tmux.conf"
tmux source-file "$CONFIG"

tmux list-clients -F "#{client_tty}" | while IFS= read -r client; do
    [[ -n "$client" ]] || continue
    tmux refresh-client -t "$client"
done

tmux display-message "Reloaded tmux.conf for all sessions"
if [[ -t 0 && -t 1 ]]; then
    exec zsh -i
fi
