#!/usr/bin/env bash
# t3m - fzf menus, tmux popups, and shortcuts for the T3 Code CLI (`t3`).
#
# Usage:
#   t3m                              Main menu (pick an action)
#   t3m projects|p                   Pick a project, then act on it
#   t3m threads|ls|t [PROJECT]       Pick a thread (all projects, or one), then act on it
#   t3m new|n [PROJECT] [MSG...]     Start a thread; prompts for anything missing
#        [--model SLUG] [--provider ID] [--worktree REF] [--branch NAME] [--title T] [--wait] [--pick-model]
#   t3m start [DIR]                  Start a thread in DIR's project (default: here), then offer to watch it
#   t3m send|s [THREAD] [MSG...]     Send a message, queued after a running turn [--wait]
#   t3m steer [THREAD] [MSG...]      Steer the running turn
#   t3m stop [THREAD]                Stop the thread
#   t3m watch [THREAD]               Follow a thread (q quit, s send, e steer, x stop, r refresh)
#   t3m window [THREAD]              Watch a thread in a new tmux window
#   t3m show [THREAD]                Show a thread's state and latest messages
#   t3m web [THREAD]                 Open a thread in the browser (works with the mobile/web app)
#   t3m add [PATH] [--title T]       Add a project (default: current directory)
#   t3m rename [PROJECT] [TITLE]     Rename a project
#   t3m rm [PROJECT]                 Remove a project (asks first)
#   t3m open [PROJECT]               Open a project in the desktop app
#   t3m worktree|wt [open|add|thread] [--repo DIR] [PATH|MSG...]
#                                    Pick a worktree, add it as a project if needed, then open it or start a thread
#   t3m worktree new BRANCH [--base REF] [--repo DIR]
#                                    Create a worktree with `wt`, add it as a project, open it
#   t3m help
#
# Anything else is passed straight to `t3` (e.g. `t3m pair`, `t3m status`, `t3m service restart`).
# PROJECT is a project id, title, or a path inside a project. THREAD is a thread id.
# Without THREAD you pick one from the current directory's project (all projects
# outside one). The last thread used per project is listed first (marked ★) and
# is shared with the Neovim :T3* commands. `steer`, `stop`, and `project list`
# need a newer t3 than 0.1.9.
#
# Env: T3_CLI (CLI command, default "t3"; may include arguments),
#      T3_BASE_DIR (T3 data dir, exported as T3CODE_HOME; default ~/.t3),
#      T3_START_ARGS (extra `thread start` flags, e.g. "--provider claudeAgent --model claude-haiku-5-5"),
#      T3M_MESSAGES (show, default 10), T3M_WATCH_MESSAGES (watch, default 15),
#      T3M_INTERVAL (watch seconds, default 3), T3M_POPUP (set by the tmux bindings).
# Requires: t3 (or T3_CLI), fzf, sqlite3, python3, jq (wt for `worktree new`).

set -euo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/t3-cli/last-threads.json"

# T3_CLI may hold arguments; split on whitespace and expand a leading ~.
read -r -a T3 <<<"${T3_CLI:-t3}"
for i in "${!T3[@]}"; do T3[$i]="${T3[$i]/#\~/$HOME}"; done
t3() { command "${T3[@]}" "$@"; }
read -r -a START_ARGS <<<"${T3_START_ARGS:-}"
# `--base-dir` only works after the subcommand; T3CODE_HOME works everywhere,
# including fzf preview subshells. State keys get a "<home>::" prefix so thread
# ids from different T3 homes never mix (same as nvim lua/t3).
KEY_PREFIX=""
if [ -n "${T3_BASE_DIR:-}" ]; then
  export T3CODE_HOME="${T3_BASE_DIR/#\~/$HOME}"
  KEY_PREFIX="$(cd -- "$T3CODE_HOME" 2>/dev/null && pwd -P || printf '%s' "$T3CODE_HOME")::"
fi
T3_HOME="${T3CODE_HOME:-$HOME/.t3}"
DB="$T3_HOME/userdata/statev2.sqlite"
MANIFEST="$T3_HOME/userdata/model-manifest.json"
if [ -n "${T3M_POPUP:-}" ]; then
  FZF_OPTS=(--height=100% --reverse --border=rounded --info=inline)
else
  FZF_OPTS=(--height=60% --reverse --border=rounded --info=inline)
fi

die() { printf 't3m: %s\n' "$*" >&2; pause; exit 1; }
info() { printf '\033[90m%s\033[0m\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF"; }
# Keep tmux popups open long enough to read an error or result.
pause() {
  [ -n "${T3M_POPUP:-}" ] && [ -t 0 ] && { read -r -n1 -s -p $'\033[90m[press a key]\033[0m' </dev/tty || true; echo; }
  return 0
}
real() { (cd -- "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"; }

# --- data -------------------------------------------------------------------

sql() {
  [ -r "$DB" ] && command -v sqlite3 >/dev/null 2>&1 || return 1
  sqlite3 -separator $'\t' "file:$DB?mode=ro" "$1" 2>/dev/null
}

q() { printf "'%s'" "${1//\'/\'\'}"; }  # SQL string literal

# id<TAB>title<TAB>workspace root, most recently updated first. Reads T3's state
# database; falls back to `t3 project list` when the database is unreadable.
data_projects() {
  sql "SELECT project_id, title, workspace_root FROM projection_projects
       WHERE deleted_at IS NULL AND archived_at IS NULL
       ORDER BY coalesce(pinned_at, '') DESC, updated_at DESC" && return
  command -v jq >/dev/null 2>&1 || return 0
  t3 project list --json 2>/dev/null |
    jq -r '.[]? | select(.deletedAt == null) | [.id, .title, .workspaceRoot] | @tsv' 2>/dev/null || true
}

# id<TAB>project<TAB>title<TAB>updated, top-level threads only. $1 = optional project id.
data_threads() {
  local where=""
  [ -n "${1:-}" ] && where="AND t.project_id = $(q "$1")"
  sql "SELECT t.thread_id, coalesce(p.title, '-'), replace(t.title, char(9), ' '),
              substr(replace(t.updated_at, 'T', ' '), 1, 16)
       FROM orchestration_v2_projection_threads t
       LEFT JOIN projection_projects p USING (project_id)
       WHERE t.deleted_at IS NULL AND t.archived_at IS NULL
         AND json_extract(t.payload_json, '$.lineage.parentThreadId') IS NULL $where
       ORDER BY t.updated_at DESC" && return
  [ -n "${1:-}" ] && command -v jq >/dev/null 2>&1 || return 0
  t3 thread list --project "$1" --json 2>/dev/null |
    jq -r '.[]? | [.threadId, "-", .title, (.status // "")] | @tsv' 2>/dev/null || true
}

# provider<TAB>model for current models.
data_models() {
  [ -r "$MANIFEST" ] || return 0
  python3 -I - "$MANIFEST" <<'PY'
import json, sys
m = json.load(open(sys.argv[1])).get("manifest", {})
for provider, models in m.get("currentModels", {}).items():
    for slug in models:
        print(f"{provider}\t{slug}")
PY
}

project_field() {  # $1 = id, $2 = field number (2 title, 3 root)
  data_projects | awk -F'\t' -v id="$1" -v f="$2" '$1 == id && !done { print $f; done = 1 }'
}

# Id of the project whose workspace root contains directory $1 (longest root).
# $2 = "exact" to require the root to be $1 itself.
project_at() {
  local abs id title root r
  abs="$(real "$1")"
  data_projects | while IFS=$'\t' read -r id title root; do
    r="$(real "$root")"
    if [ "${2:-}" = exact ]; then
      if [ "$abs" = "$r" ]; then printf '%s\t%s\n' "${#r}" "$id"; fi
    else
      # "(pattern)": macOS bash 3.2 cannot parse "pattern)" inside $(...).
      case "$abs/" in ("$r/"*) printf '%s\t%s\n' "${#r}" "$id" ;; esac
    fi
  done | sort -rn | head -1 | cut -f2
}

# Resolve a project id, title, or path to a project id. A directory outside every
# project offers to add its Git root. Without any project data, the Git root is
# used as is: thread commands accept any path inside a project.
resolve_project() {
  local arg="$1" id root
  id="$(data_projects | awk -F'\t' -v a="$arg" '($1 == a || $2 == a) && !done { print $1; done = 1 }')"
  if [ -z "$id" ] && [ -d "$arg" ]; then
    id="$(project_at "$arg")"
    if [ -z "$id" ]; then
      root="$(git -C "$arg" rev-parse --show-toplevel 2>/dev/null || real "$arg")"
      if [ -z "$(data_projects)" ]; then
        id="$root"
      else
        confirm "No T3 project contains $(real "$arg"). Add $root?" || die "no project"
        t3 project add "$root" >&2 || die "t3 project add failed"
        id="$(project_at "$root")"
      fi
    fi
  fi
  [ -n "$id" ] || die "no T3 project matches '$arg'"
  printf '%s\n' "$id"
}

# Key of project $1 in the shared last-thread state: the real workspace root.
project_key() {
  local root; root="$(project_field "$1" 3)"
  printf '%s%s\n' "$KEY_PREFIX" "$(real "${root:-$1}")"
}

# --- last-thread state (shared with nvim lua/t3) ------------------------------

last_thread() {
  [ -r "$STATE" ] && command -v jq >/dev/null 2>&1 || return 0
  jq -r --arg p "$1" '.[$p] // empty' "$STATE" 2>/dev/null || true
}

remember() {  # $1 thread id, $2 optional project id
  command -v jq >/dev/null 2>&1 || return 0
  local project="${2:-}" key cur='{}'
  [ -n "$project" ] || project="$(sql "SELECT project_id FROM orchestration_v2_projection_threads
                                       WHERE thread_id = $(q "$1")" || true)"
  [ -n "$project" ] || project="$(project_at "$PWD")"
  [ -n "$project" ] || return 0
  key="$(project_key "$project")"
  mkdir -p "$(dirname "$STATE")"
  [ -r "$STATE" ] && cur="$(cat "$STATE")"
  # A corrupt state file would otherwise block every later write.
  jq -e 'type == "object"' <<<"$cur" >/dev/null 2>&1 || cur='{}'
  jq -c --arg p "$key" --arg t "$1" '. + {($p): $t}' <<<"$cur" >"$STATE.tmp" 2>/dev/null \
    && mv "$STATE.tmp" "$STATE" || rm -f "$STATE.tmp"
}

# --- pickers ----------------------------------------------------------------

pick_project() {
  need fzf
  local line
  line="$(data_projects | fzf "${FZF_OPTS[@]}" --delimiter=$'\t' --with-nth=2,3 \
    --prompt='project> ' --header='enter: select' \
    --preview "$(printf '%q' "$SELF") _preview-project {1}" --preview-window=right,55%)" \
    || die "no project selected"
  cut -f1 <<<"$line"
}

pick_thread() {  # $1 = optional project id; its last thread comes first (★)
  need fzf
  local project="${1:-}" last="" line
  [ -n "$project" ] && last="$(last_thread "$(project_key "$project")")"
  line="$(data_threads "$project" | awk -F'\t' -v last="$last" '
      $1 == last { print $0 "\t★"; next } { rest[++n] = $0 "\t " }
      END { for (i = 1; i <= n; i++) print rest[i] }' |
    fzf "${FZF_OPTS[@]}" --delimiter=$'\t' --with-nth=5,4,2,3 --no-sort \
      --prompt='thread> ' --header='enter: select · ctrl-/: toggle preview' \
      --bind 'ctrl-/:toggle-preview' \
      --preview "$(printf '%q ' "${T3[@]}")thread show --messages 3 {1} 2>&1" \
      --preview-window=right,60%,wrap)" || die "no thread selected"
  cut -f1 <<<"$line"
}

# Thread from $1, or picked in the current directory's project (all projects
# outside one). Remembers it as its project's last thread.
target_thread() {
  local thread="${1:-}"
  [ -n "$thread" ] || thread="$(pick_thread "$(project_at "$PWD")")"
  remember "$thread"
  printf '%s\n' "$thread"
}

pick_model() {  # prints "provider<TAB>model"
  need fzf
  data_models | fzf "${FZF_OPTS[@]}" --delimiter=$'\t' --prompt='model> ' \
    --header='enter: select · esc: project default' || true
}

menu() {  # $1 = prompt, rest = "key<TAB>label" lines; prints chosen key
  need fzf
  local prompt="$1"; shift
  printf '%s\n' "$@" | fzf "${FZF_OPTS[@]}" --height=~50% --delimiter=$'\t' --with-nth=2 \
    --prompt="$prompt> " --no-sort | cut -f1
}

read_message() {  # $1 = prompt label; empty input opens $EDITOR
  local msg tmp
  read -r -e -p "${1:-Message} (empty = \$EDITOR): " msg </dev/tty || true
  if [ -z "$msg" ]; then
    tmp="$(mktemp "${TMPDIR:-/tmp}/t3m-msg.XXXXXX")"
    "${EDITOR:-vi}" "$tmp" </dev/tty >/dev/tty
    msg="$(cat "$tmp")"; rm -f "$tmp"
  fi
  [ -n "${msg//[[:space:]]/}" ] || die "empty message"
  printf '%s' "$msg"
}

confirm() {
  local ans
  read -r -p "$1 [y/N] " ans </dev/tty || true
  [[ "$ans" =~ ^[Yy] ]]
}

# --- thread commands ----------------------------------------------------------

# Starts a thread and sets NEW_THREAD (left empty with --wait or --json).
cmd_new() {
  local project="" provider="" model="" worktree="" branch="" pick_m=0 passthrough=0 msg="" out
  local -a extra=() words=()
  NEW_THREAD=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --model) model="$2"; shift 2 ;;
      --provider) provider="$2"; shift 2 ;;
      --worktree) worktree="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --wait|--json) extra+=("$1"); passthrough=1; shift ;;
      --pick-model|-m) pick_m=1; shift ;;
      --title) extra+=(--title "$2"); shift 2 ;;
      *) words+=("$1"); shift ;;
    esac
  done
  if [ ${#words[@]} -gt 0 ]; then
    project="$(resolve_project "${words[0]}")"; words=("${words[@]:1}")
  else
    project="$(pick_project)"
  fi
  if [ "$pick_m" = 1 ] && [ -z "$model" ]; then
    local sel; sel="$(pick_model)"
    [ -n "$sel" ] && { provider="$(cut -f1 <<<"$sel")"; model="$(cut -f2 <<<"$sel")"; }
  fi
  info "project: $(project_field "$project" 2) ($project)"
  if [ ${#words[@]} -gt 0 ]; then msg="${words[*]}"; else msg="$(read_message "New thread")"; fi
  local -a args=(thread start ${START_ARGS[@]+"${START_ARGS[@]}"})
  [ -n "$provider" ] && args+=(--provider "$provider")
  [ -n "$model" ] && args+=(--model "$model")
  [ -n "$worktree" ] && args+=(--worktree "$worktree")
  [ -n "$branch" ] && args+=(--branch "$branch")
  args+=(${extra[@]+"${extra[@]}"})
  info "t3 ${args[*]}"
  if [ "$passthrough" = 1 ]; then
    printf '%s' "$msg" | t3 "${args[@]}" "$project" -
    return
  fi
  out="$(printf '%s' "$msg" | t3 "${args[@]}" --json "$project" -)" || die "t3 thread start failed"
  NEW_THREAD="$(sed -n 's/.*"threadId" *: *"\([^"]*\)".*/\1/p' <<<"$out" | head -1)"
  if [ -z "$NEW_THREAD" ]; then printf '%s\n' "$out"; return; fi
  remember "$NEW_THREAD" "$project"
  printf 'Started %s\n' "$NEW_THREAD"
}

cmd_start() {  # $1 = directory (default: here), rest = cmd_new flags and message
  local dir="${1:-.}"; [ $# -gt 0 ] && shift
  local project; project="$(resolve_project "$dir")"
  cmd_new "$project" "$@"
  if [ -n "$NEW_THREAD" ] && confirm "Watch it?"; then cmd_watch "$NEW_THREAD"; fi
}

cmd_send() {  # $1 = queue|steer, then [--wait] [THREAD] [MSG...]
  local mode="$1"; shift
  local thread="" msg; local -a extra=() words=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait|--json) extra+=("$1"); shift ;;
      *) words+=("$1"); shift ;;
    esac
  done
  if [ ${#words[@]} -gt 0 ]; then thread="${words[0]}"; words=("${words[@]:1}"); fi
  thread="$(target_thread "$thread")"
  if [ ${#words[@]} -gt 0 ]; then msg="${words[*]}"; else msg="$(read_message "$mode → $thread")"; fi
  if [ "$mode" = steer ]; then
    printf '%s' "$msg" | t3 thread steer "$thread" - || die "t3 thread steer failed"
  else
    # queue is the default; no --mode keeps t3 <= 0.1.9 working.
    printf '%s' "$msg" | t3 thread send ${extra[@]+"${extra[@]}"} "$thread" - || die "t3 thread send failed"
  fi
  pause
}

cmd_stop() {
  local thread; thread="$(target_thread "${1:-}")"
  t3 thread stop "$thread" || die "t3 thread stop failed"
  pause
}

cmd_watch() {
  local thread; thread="$(target_thread "${1:-}")"
  local n="${T3M_WATCH_MESSAGES:-15}" every="${T3M_INTERVAL:-3}" key out
  while :; do
    out="$(t3 thread show --messages "$n" "$thread" 2>&1)" || true
    printf '\033[H\033[2J%s\n\n\033[90m%s · every %ss · q quit · s send · e steer · x stop · r refresh\033[0m\n' \
      "$out" "$(date +%H:%M:%S)" "$every"
    key=""; read -r -s -n1 -t "$every" key </dev/tty || true
    case "$key" in
      q) break ;;
      # Subshells: an empty message or a failed send must not end the watch.
      s) (cmd_send queue "$thread") || true ;;
      e) (cmd_send steer "$thread") || true ;;
      x) t3 thread stop "$thread" || true; sleep 1 ;;
    esac
  done
}

cmd_window() {
  [ -n "${TMUX:-}" ] || die "not inside tmux"
  local thread; thread="$(target_thread "${1:-}")"
  tmux new-window -c "$PWD" -n "t3:${thread:0:8}" "$(printf '%q ' "$SELF" watch "$thread")"
}

cmd_show() {
  local thread; thread="$(target_thread "${1:-}")"
  t3 thread show --messages "${T3M_MESSAGES:-10}" "$thread" | "${PAGER:-less}" -R
}

thread_link() {
  t3 thread show --messages 0 --json "$1" | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["thread"]["link"])'
}

cmd_web() {
  local thread; thread="$(target_thread "${1:-}")"
  local link; link="$(thread_link "$thread")" || die "could not get link for $thread"
  info "$link"
  open "$link" 2>/dev/null || xdg-open "$link"
}

# --- project commands ---------------------------------------------------------

cmd_add() {
  local path="." ; local -a extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) extra+=(--title "$2"); shift 2 ;;
      *) path="$1"; shift ;;
    esac
  done
  path="$(cd -- "$path" && pwd -P)" || die "no such directory: $path"
  t3 project add "${extra[@]+"${extra[@]}"}" "$path"
}

cmd_rename() {
  local project title
  if [ $# -gt 0 ]; then project="$(resolve_project "$1")"; shift; else project="$(pick_project)"; fi
  if [ $# -gt 0 ]; then title="$*"; else read -r -e -p "New title [$(project_field "$project" 2)]: " title </dev/tty; fi
  [ -n "$title" ] || die "empty title"
  t3 project rename "$project" "$title"
}

cmd_rm() {
  local project; if [ $# -gt 0 ]; then project="$(resolve_project "$1")"; else project="$(pick_project)"; fi
  local name; name="$(project_field "$project" 2) ($(project_field "$project" 3))"
  confirm "Remove T3 project $name? Files on disk are not touched." || die "cancelled"
  if ! t3 project remove "$project"; then
    confirm "It still has threads. Delete the project AND all its threads?" || die "cancelled"
    t3 project remove --force "$project"
  fi
}

cmd_open() {
  local project; if [ $# -gt 0 ]; then project="$(resolve_project "$1")"; else project="$(pick_project)"; fi
  local root; root="$(project_field "$project" 3)"
  t3 app "${root:-$project}"
}

# --- worktrees ----------------------------------------------------------------

# A directory git can run in for repo $1 (bare-layout roots are not work trees).
git_dir_for() {
  if git -C "$1" rev-parse --git-dir >/dev/null 2>&1; then printf '%s\n' "$1"
  elif [ -d "$1/.bare" ]; then printf '%s\n' "$1/.bare"
  elif [ -e "$1/main/.git" ]; then printf '%s\n' "$1/main"
  else return 1
  fi
}

# Worktrees of the repo at $1 as "branch<TAB>path", skipping the bare entry.
list_worktrees() {
  git -C "$1" worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10); branch = ""; bare = 0; next }
    /^branch /   { branch = substr($0, 8); sub("^refs/heads/", "", branch); next }
    /^detached/  { branch = "(detached)"; next }
    /^bare/      { bare = 1; next }
    /^$/         { if (path != "" && !bare) printf "%s\t%s\n", branch, path; path = "" }
    END          { if (path != "" && !bare) printf "%s\t%s\n", branch, path }
  '
}

# Worktree path from repo $1, the current repo, or a picked project's repo.
pick_worktree() {
  local repo="${1:-}" lines line
  if [ -z "$repo" ]; then
    if git rev-parse --git-dir >/dev/null 2>&1; then repo="$PWD"
    else repo="$(project_field "$(pick_project)" 3)"; fi
  fi
  lines="$(list_worktrees "$repo")"
  [ -n "$lines" ] || die "no worktrees found for $repo"
  if [ "$(printf '%s\n' "$lines" | wc -l | tr -d ' ')" = 1 ]; then
    cut -f2 <<<"$lines"
    return
  fi
  need fzf
  line="$(printf '%s\n' "$lines" | fzf "${FZF_OPTS[@]}" --delimiter=$'\t' --tabstop=40 \
    --prompt='worktree> ' --header='enter: select · preview: T3 threads for this worktree' \
    --preview "$(printf '%q' "$SELF") _preview-worktree {2}" --preview-window=right,55%)" \
    || die "no worktree selected"
  cut -f2 <<<"$line"
}

ensure_project() {  # $1 = worktree path; adds it as a T3 project unless it is one
  local path="$1" title branch common
  if [ -n "$(project_at "$path" exact)" ]; then
    info "already a T3 project: $path"
    return
  fi
  branch="$(git -C "$path" branch --show-current 2>/dev/null || true)"
  common="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || printf '%s/.git' "$path")"
  title="$(basename "$(dirname "$common")" | sed 's/^\.//')"
  [ -n "$branch" ] && title="$title ($branch)"
  info "adding T3 project: $title -> $path"
  t3 project add --title "$title" "$path" >&2 || info "t3 project add failed; continuing with $path"
}

cmd_worktree() {
  local action=open repo="" base="" path
  local -a words=()
  case "${1:-}" in open|add|thread|new) action="$1"; shift ;; esac
  while [ $# -gt 0 ]; do
    case "$1" in
      -r|--repo) [ $# -ge 2 ] || die "--repo needs a value"; repo="$(git_dir_for "$2")" || die "not a git repo: $2"; shift 2 ;;
      -b|--base) [ $# -ge 2 ] || die "--base needs a value"; base="$2"; shift 2 ;;
      *) words+=("$1"); shift ;;
    esac
  done
  case "$action" in
    new)
      need wt
      [ ${#words[@]} -eq 1 ] || die "usage: t3m worktree new BRANCH [--base REF] [--repo DIR]"
      repo="${repo:-$PWD}"
      git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repo: $repo"
      local -a wt_args=(switch --create "${words[0]}" --no-cd)
      [ -n "$base" ] && wt_args+=(--base "$base")
      (cd -- "$repo" && command wt "${wt_args[@]}")
      path="$(list_worktrees "$repo" | awk -F'\t' -v b="${words[0]}" '("x" $1) == ("x" b) && !done { print $2; done = 1 }')"
      [ -n "$path" ] || die "could not find the new worktree for ${words[0]}" ;;
    add)
      if [ ${#words[@]} -gt 0 ]; then
        path="$(cd -- "${words[0]}" && pwd -P)" || die "no such directory: ${words[0]}"
      else
        path="$(pick_worktree "$repo")"
      fi ;;
    *) path="$(pick_worktree "$repo")" ;;
  esac
  ensure_project "$path"
  case "$action" in
    open|new) t3 app "$path" ;;
    thread) cmd_new "$path" ${words[@]+"${words[@]}"} ;;
  esac
}

# --- menus --------------------------------------------------------------------

thread_actions() {
  local thread="$1" action
  local -a items=($'show\tShow messages' $'watch\tWatch' $'send\tSend a message (queue)'
    $'steer\tSteer the running turn' $'stop\tStop' $'web\tOpen in browser / web app' $'copy\tCopy thread id')
  [ -n "${TMUX:-}" ] && items+=($'window\tWatch in a new tmux window')
  action="$(menu "thread" "${items[@]}")" || return 0
  case "$action" in
    show) cmd_show "$thread" ;;
    watch) cmd_watch "$thread" ;;
    send) cmd_send queue "$thread" ;;
    steer) cmd_send steer "$thread" ;;
    stop) cmd_stop "$thread" ;;
    window) cmd_window "$thread" ;;
    web) cmd_web "$thread" ;;
    copy) printf '%s' "$thread" | pbcopy 2>/dev/null && info "copied $thread" || printf '%s\n' "$thread" ;;
  esac
}

cmd_threads() {
  local project=""; [ $# -gt 0 ] && project="$(resolve_project "$1")"
  local thread; thread="$(pick_thread "$project")"
  remember "$thread"
  thread_actions "$thread"
}

cmd_projects() {
  local project action
  project="$(pick_project)"
  action="$(menu "$(project_field "$project" 2)" \
    $'threads\tBrowse threads' $'new\tStart a thread' $'newwt\tStart a thread in a new worktree' \
    $'open\tOpen in desktop app' $'rename\tRename' $'rm\tRemove')" || return 0
  case "$action" in
    threads) cmd_threads "$project" ;;
    new) cmd_new --pick-model "$project" ;;
    newwt)
      local base branch
      read -r -e -p "Base ref [main]: " base </dev/tty; base="${base:-main}"
      read -r -e -p "New branch name: " branch </dev/tty
      [ -n "$branch" ] || die "branch name required"
      cmd_new --pick-model --worktree "$base" --branch "$branch" "$project" ;;
    open) cmd_open "$project" ;;
    rename) cmd_rename "$project" ;;
    rm) cmd_rm "$project" ;;
  esac
}

cmd_menu() {
  local action
  local -a items=(
    $'start\tStart a thread here' $'send\tSend to a thread (queue)' $'steer\tSteer a running thread'
    $'stop\tStop a thread' $'watch\tWatch a thread')
  [ -n "${TMUX:-}" ] && items+=($'window\tWatch a thread in a new tmux window')
  items+=(
    $'threads\tBrowse threads (all projects)' $'projects\tBrowse projects'
    $'new\tStart a thread (pick project and model)' $'worktree\tOpen a worktree as a project'
    $'add\tAdd current directory as a project' $'open\tOpen a project in the desktop app'
    $'web\tOpen a thread in the browser' $'pair\tPair a phone (QR code)'
    $'status\tService and remote access status' $'restart\tRestart background service'
    $'doctor\tCheck and repair T3 data' $'update\tUpdate t3')
  action="$(menu "t3" "${items[@]}")" || return 0
  case "$action" in
    start) cmd_start ;;
    send) cmd_send queue ;;
    steer) cmd_send steer ;;
    stop) cmd_stop ;;
    watch) cmd_watch ;;
    window) cmd_window ;;
    threads) cmd_threads ;;
    projects) cmd_projects ;;
    new) cmd_new --pick-model ;;
    worktree) cmd_worktree ;;
    add) cmd_add . ;;
    open) cmd_open ;;
    web) cmd_web ;;
    pair) t3 pair; pause ;;
    status) t3 status; pause ;;
    restart) t3 service restart; pause ;;
    doctor) t3 doctor; pause ;;
    update) t3 update; pause ;;
  esac
}

# Internal helpers used by fzf previews and zsh completion.
internal() {
  local id root
  case "$1" in
    _projects) data_projects ;;
    _threads) data_threads "${2:+$(resolve_project "$2")}" ;;
    _models) data_models ;;
    _preview-project)
      root="$(project_field "$2" 3)"
      printf '\033[1m%s\033[0m\n%s\n\n' "$(project_field "$2" 2)" "$root"
      git -C "$root" branch --show-current 2>/dev/null | sed 's/^/branch: /' || true
      printf '\nRecent threads:\n'
      data_threads "$2" | head -15 | awk -F'\t' '{ printf "  %s  %s\n", $4, $3 }' ;;
    _preview-worktree)
      id="$(project_at "$2" exact)"
      if [ -n "$id" ]; then internal _preview-project "$id"; else echo "(not a T3 project yet)"; fi ;;
  esac
}

main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    _*) internal "$cmd" "$@"; return ;;
    -h|--help|help) usage; return ;;
  esac
  need "${T3[0]}"
  case "$cmd" in
    ""|menu)      cmd_menu ;;
    projects|p)   cmd_projects ;;
    threads|ls|t) cmd_threads "$@" ;;
    new|n)        cmd_new "$@" ;;
    start)        cmd_start "$@" ;;
    send|s)       cmd_send queue "$@" ;;
    steer)        cmd_send steer "$@" ;;
    stop)         cmd_stop "$@" ;;
    watch)        cmd_watch "$@" ;;
    window)       cmd_window "$@" ;;
    show)         cmd_show "$@" ;;
    web)          cmd_web "$@" ;;
    add)          cmd_add "$@" ;;
    rename)       cmd_rename "$@" ;;
    rm)           cmd_rm "$@" ;;
    open)         cmd_open "$@" ;;
    worktree|wt)  need git; cmd_worktree "$@" ;;
    *)            exec "${T3[@]}" "$cmd" "$@" ;;
  esac
}

main "$@"
