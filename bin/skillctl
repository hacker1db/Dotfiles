#!/usr/bin/env bash

skillctl_repo="${SKILLCTL_REPO_DIR:-$HOME/Developer/skills}"
if [ -f "$skillctl_repo/go.mod" ]; then
    skillctl_checkout="$skillctl_repo"
elif [ -f "$skillctl_repo/main/go.mod" ]; then
    skillctl_checkout="$skillctl_repo/main"
else
    echo "No skillctl checkout found at $skillctl_repo. Clone https://github.com/hacker1db/skills there or set SKILLCTL_REPO_DIR." >&2
    exit 1
fi

# Tab completion runs on every keypress; reuse the last build instead of rebuilding.
case "${1:-}" in
__complete | __completeNoDesc | completion)
    if [ -x "$skillctl_checkout/skillctl" ]; then
        exec "$skillctl_checkout/skillctl" "$@"
    fi
    ;;
esac

skillctl_build_dir="$(mktemp -d "$skillctl_checkout/.skillctl-build.XXXXXXXX")" || exit $?
trap 'rm -rf -- "$skillctl_build_dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

(cd "$skillctl_checkout" && go build -mod=readonly -o "$skillctl_build_dir/skillctl" .) || exit $?
mv -f "$skillctl_build_dir/skillctl" "$skillctl_checkout/skillctl" || exit $?
rm -rf -- "$skillctl_build_dir" || exit $?
trap - EXIT HUP INT TERM

exec "$skillctl_checkout/skillctl" "$@"
