#!/usr/bin/env zsh

go() {
    if [[ -n "$TMUX" ]]; then
        tmux switch-client -t "=$1"
    else
        tmux attach-session -t "=$1"
    fi
}

create() {
    local name="$1"
    if [[ -z "$name" ]]; then
        name="${PWD:t}"
        read "name?Enter new session name [$name]: " || exit 1
        [[ -n "$name" ]] || name="${PWD:t}"
    fi
    name="${name//[.:]/_}"
    tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$PWD"
    go "$name"
}

if [[ -n "$1" ]]; then
    create "$1"
    exit
fi

local current=""
[[ -n "$TMUX" ]] && current="$(tmux display-message -p '#S')"

local -a sessions choices
sessions=(${(f)"$(tmux list-sessions -F '#S' 2>/dev/null)"})
sessions=(${sessions:#$current})
choices=($sessions "New Session")
[[ -z "$TMUX" ]] && choices+=("zsh")

print "Available sessions"
[[ -n "$current" ]] && print "(current: $current)"
print -- "------------------\n"

PS3="Please choose your session: "
select opt in $choices; do
    case "$opt" in
        "New Session") create; break ;;
        "zsh") exec zsh --login ;;
        "") print -u2 "Invalid choice" ;;
        *) go "$opt"; break ;;
    esac
done
