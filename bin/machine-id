#!/bin/sh
# Print this machine's fleet identity: `machine-id [label|color]`.
# hostname is the generic "MacBookPro" on every Mac, so prefer the macOS LocalHostName.
# Fleet hosts are inventoried in fleet-manager (fleet.json); any other machine is the work machine.
name=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
case $(printf %s "$name" | tr '[:upper:]' '[:lower:]') in
	stronghold*) label=STRONGHOLD color='#f16c75' ;; # Eldritch red
	aiserver*) label=AISERVER color='#f7c67f' ;;     # Eldritch orange
	*) label=WORK color='' ;;                        # keep the theme's standard accent
esac
case $1 in
	label) echo "$label" ;;
	color) echo "$color" ;;
	*) echo "$label $color" ;;
esac
