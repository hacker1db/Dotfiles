#!/bin/sh
# Secret-scan hook for Claude Code, Codex, and Copilot.
#
# Picks the scanner from the machine's GitHub identity, so the same hook
# config works on every machine:
#   github.user == hacker1db  -> betterleaks (personal)
#   anything else             -> ggshield (work, GitGuardian)
# Override with AGENT_SECRET_SCANNER=betterleaks|ggshield|none.
# A missing scanner skips the scan instead of breaking the agent.

export PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

scanner=${AGENT_SECRET_SCANNER:-}
if [ -z "$scanner" ]; then
	if [ "$(git config --includes --global --get github.user 2>/dev/null)" = hacker1db ]; then
		scanner=betterleaks
	else
		scanner=ggshield
	fi
fi

case "$scanner" in
betterleaks)
	command -v betterleaks >/dev/null 2>&1 || exit 0
	betterleaks stdin --redact --no-banner --log-level error >&2
	rc=$?
	case "$rc" in
	0) exit 0 ;;
	1) echo "betterleaks found a possible secret (or could not scan) in this agent event; blocked." >&2 ;;
	*) echo "betterleaks failed (exit $rc); blocked because the event was not scanned." >&2 ;;
	esac
	exit 2
	;;
ggshield)
	command -v ggshield >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || exit 0
	jq -c 'if ((.transcript_path // "") | test("claude")) then . else with_entries(select(.key | IN("hook_event_name", "session_id", "timestamp", "cwd", "prompt", "tool_name", "tool_input", "tool_result"))) end' |
		ggshield secret scan ai-hook
	;;
none) exit 0 ;;
*)
	echo "agent-secret-scan: unknown AGENT_SECRET_SCANNER '$scanner'" >&2
	exit 0
	;;
esac
