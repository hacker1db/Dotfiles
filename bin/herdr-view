#!/usr/bin/env zsh
set -euo pipefail

(( $# )) || { print -u2 "Usage: ${0:t} <file.pdf> ..."; exit 2 }
command -v herdr-app >/dev/null 2>&1 || { print -u2 "herdr-app is not installed"; exit 1 }

typeset file abs
for file in "$@"; do
    [[ -f "$file" ]] || { print -u2 "No such file: $file"; exit 1 }
    abs="${file:A}"
    case "${(L)abs}" in
        *.pdf)
            herdr-app do tab.new --mod pdf-view --name "${abs:t}" \
                --props "$(jq -cn --arg path "$abs" '{path: $path}')" >/dev/null
            ;;
        *) print -u2 "Not a PDF: $file"; exit 1 ;;
    esac
done
