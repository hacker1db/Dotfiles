#!/usr/bin/env bash

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT

usage() {
  cat << EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h] [-v] [-l <location>] <repository>
       $(basename "${BASH_SOURCE[0]}") [-h] [-v] [-l <location>] --init <name> [--remote <url>] [--branch <name>]
       $(basename "${BASH_SOURCE[0]}") --fix [<path>]

Set up a bare git repo for working exclusively with worktrees.

Modes:
  clone (default)   Clone an existing remote repository
  --init            Initialize a new bare repository from scratch
  --fix             Fix an existing repo missing the .git pointer or fetch config

Available options:

-h, --help          Print this help and exit
-v, --verbose       Print script debug info
-l, --location      Location of bare repo contents (default: .bare)
    --init          Initialize a new repo instead of cloning
    --fix           Fix an existing bare repo (defaults to current directory)
    --remote        Remote URL to add when using --init (optional)
    --branch        Default branch name for --init (default: main)

Result layout:
  <name>/
    .bare/          <- git data
    .git            <- gitdir pointer: gitdir: ./.bare
    <branch>/       <- initial worktree, start working here

Examples:
  git-bare-clone git@github.com:user/repo.git
  git-bare-clone --init my-project
  git-bare-clone --init my-project --remote git@github.com:user/my-project.git
  git-bare-clone --init my-project --branch develop
  git-bare-clone --fix
  git-bare-clone --fix /path/to/existing/repo
EOF
  exit
}

cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
}

setup_colors() {
  if [[ -t 2 ]] && [[ -z "${NO_COLOR-}" ]] && [[ "${TERM-}" != "dumb" ]]; then
    NOFORMAT='\033[0m' RED='\033[0;31m' GREEN='\033[0;32m' ORANGE='\033[0;33m' BLUE='\033[0;34m' PURPLE='\033[0;35m' CYAN='\033[0;36m' YELLOW='\033[1;33m'
  else
    NOFORMAT='' RED='' GREEN='' ORANGE='' BLUE='' PURPLE='' CYAN='' YELLOW=''
  fi
}

msg() {
  echo >&2 -e "${1-}"
}

die() {
  local msg=$1
  local code=${2-1}
  msg "$msg"
  exit "$code"
}

parse_params() {
  location='.bare'
  init_mode=0
  fix_mode=0
  remote_url=''
  default_branch='main'

  while :; do
    case "${1-}" in
    -h | --help) usage ;;
    -v | --verbose) set -x ;;
    --no-color) NO_COLOR=1 ;;
    --init) init_mode=1 ;;
    --fix) fix_mode=1 ;;
    -l | --location)
      location="${2-}"
      shift
      ;;
    --remote)
      remote_url="${2-}"
      shift
      ;;
    --branch)
      default_branch="${2-}"
      shift
      ;;
    -?*) die "Unknown option: $1" ;;
    *) break ;;
    esac
    shift
  done

  args=("$@")
  [[ $fix_mode -eq 0 && ${#args[@]} -eq 0 ]] && die "Missing required argument (repository URL or project name)"

  return 0
}

repo_dir_from_arg() {
  local repo_arg=${1%%/}
  local base=${repo_arg##*/}
  base=${base%.git}
  [[ -z "$base" ]] && die "Could not determine repo directory name from: $1"
  echo "$base"
}

do_clone() {
  local repo_arg="$1"
  local repo_dir
  repo_dir=$(repo_dir_from_arg "$repo_arg")

  [[ -e "$repo_dir" ]] && die "Target directory already exists: $repo_dir"

  msg "${YELLOW}Creating repo directory $repo_dir...${NOFORMAT}"
  mkdir -p "$repo_dir"
  pushd "$repo_dir" > /dev/null

  msg "${YELLOW}Cloning bare repository to $location...${NOFORMAT}"
  git clone --bare "$repo_arg" "$location"

  msg "${YELLOW}Creating .git pointer file...${NOFORMAT}"
  echo "gitdir: ./.bare" > .git

  msg "${YELLOW}Adjusting origin fetch locations...${NOFORMAT}"
  git -C "$location" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  git -C "$location" fetch origin

  # Detect default branch from remote HEAD
  local branch
  branch=$(git -C "$location" symbolic-ref --short HEAD 2>/dev/null || echo "$default_branch")

  msg "${YELLOW}Creating worktree for '$branch'...${NOFORMAT}"
  GIT_DIR="$location" git worktree add "$branch" "$branch"

  popd > /dev/null
  msg "${GREEN}Success. Cloned into $repo_dir/${NOFORMAT}"
  msg "${CYAN}Next: cd $repo_dir/$branch${NOFORMAT}"
}

do_init() {
  local repo_dir="$1"

  [[ -e "$repo_dir" ]] && die "Target directory already exists: $repo_dir"

  msg "${YELLOW}Creating repo directory $repo_dir...${NOFORMAT}"
  mkdir -p "$repo_dir"
  pushd "$repo_dir" > /dev/null

  msg "${YELLOW}Initializing bare repository in $location...${NOFORMAT}"
  git init --bare --initial-branch="$default_branch" "$location"

  msg "${YELLOW}Creating .git pointer file...${NOFORMAT}"
  echo "gitdir: ./.bare" > .git

  msg "${YELLOW}Creating initial empty commit on '$default_branch'...${NOFORMAT}"
  local empty_tree initial_commit
  empty_tree=$(git -C "$location" hash-object -t tree /dev/null)
  initial_commit=$(git -C "$location" commit-tree "$empty_tree" -m "Initial commit")
  git -C "$location" update-ref "refs/heads/$default_branch" "$initial_commit"

  if [[ -n "$remote_url" ]]; then
    msg "${YELLOW}Adding remote origin: $remote_url${NOFORMAT}"
    git -C "$location" remote add origin "$remote_url"
    git -C "$location" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  fi

  msg "${YELLOW}Creating worktree for '$default_branch'...${NOFORMAT}"
  GIT_DIR="$location" git worktree add "$default_branch" "$default_branch"

  popd > /dev/null
  msg "${GREEN}Success. Initialized $repo_dir/${NOFORMAT}"
  if [[ -n "$remote_url" ]]; then
    msg "${CYAN}Remote set to: $remote_url${NOFORMAT}"
    msg "${CYAN}Push when ready: cd $repo_dir/$default_branch && git push -u origin $default_branch${NOFORMAT}"
  fi
  msg "${CYAN}Next: cd $repo_dir/$default_branch${NOFORMAT}"
}

do_fix() {
  local target="${1:-.}"
  [[ -d "$target" ]] || die "Directory not found: $target"
  pushd "$target" > /dev/null

  # Find bare repo — try configured location, then .git dir contents, then a bare repo at root
  local bare_loc="$location"
  if [[ ! -d "$bare_loc" ]]; then
    # Maybe it's a regular clone with a .git directory — check if .git is a bare repo
    if [[ -d ".git" && -f ".git/config" ]] && grep -q "bare = true" ".git/config" 2>/dev/null; then
      msg "${YELLOW}Found bare repo inside .git/ — moving to $bare_loc...${NOFORMAT}"
      mv .git "$bare_loc"
    else
      die "No bare repo found at '$bare_loc'. Is this the right directory?"
    fi
  fi

  # Write .git pointer if missing or wrong
  local current_ptr=""
  [[ -f ".git" ]] && current_ptr=$(cat .git)
  if [[ "$current_ptr" != "gitdir: ./.bare" ]]; then
    msg "${YELLOW}Writing .git pointer file...${NOFORMAT}"
    echo "gitdir: ./.bare" > .git
    msg "${GREEN}  .git -> gitdir: ./.bare${NOFORMAT}"
  else
    msg "${GREEN}  .git pointer already correct, skipping.${NOFORMAT}"
  fi

  # Fix fetch refspec if missing
  local fetch_cfg
  fetch_cfg=$(git -C "$bare_loc" config --get remote.origin.fetch 2>/dev/null || true)
  if [[ "$fetch_cfg" != "+refs/heads/*:refs/remotes/origin/*" ]]; then
    msg "${YELLOW}Fixing remote.origin.fetch refspec...${NOFORMAT}"
    git -C "$bare_loc" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
    msg "${GREEN}  fetch refspec updated.${NOFORMAT}"
  else
    msg "${GREEN}  fetch refspec already correct, skipping.${NOFORMAT}"
  fi

  # Fetch to populate remote tracking refs
  msg "${YELLOW}Fetching from origin...${NOFORMAT}"
  git -C "$bare_loc" fetch origin

  popd > /dev/null
  msg "${GREEN}Done. Repo at '$target' is fixed.${NOFORMAT}"
}

parse_params "$@"
setup_colors

if [[ $fix_mode -eq 1 ]]; then
  do_fix "${args[0]-}"
elif [[ $init_mode -eq 1 ]]; then
  do_init "${args[0]}"
else
  do_clone "${args[0]}"
fi
