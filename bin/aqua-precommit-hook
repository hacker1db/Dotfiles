#!/usr/bin/env bash
# Agent PreToolUse hook: run the Aqua image scan before an agent's `git commit`.
#
# Usage (from hook config): aqua-precommit-hook claude|copilot   (hook JSON on stdin)
#
# Acts only when ALL are true, otherwise exits 0 silently:
#   - the tool call is a shell command containing `git ... commit`
#   - the repo's origin is an Alaska GitHub org (github.com/Alaska-*)
#   - the repo has a Dockerfile under ci/ or deployments/ (or at the root)
# Then runs `aqua_scan <repo>` from ~/.localrc (podman + pipeline scanner image).
# A failed scan or build denies the tool call with the reason and report path.
# Passing results are cached per working-tree state in ~/.cache/aqua-scan/passed.
#
# Env:
#   AQUA_PRECOMMIT=off    disable the hook (set in the agent's launch environment)
#   AQUA_LOCALRC          file defining aqua_scan (default ~/.localrc)
set -uo pipefail

agent="${1:-claude}"
[[ "${AQUA_PRECOMMIT:-on}" == off ]] && exit 0
command -v jq >/dev/null 2>&1 || exit 0

input="$(cat)"

# Extract the shell command and cwd from either payload shape
#   Claude:  {tool_name, tool_input:{command}, cwd}
#   Copilot: {toolName, toolArgs:"<json string>", cwd}
cmd="$(jq -r '
  (.tool_input.command // empty),
  (.toolArgs | (if type=="string" then (fromjson? // {}) else . end) | .command? // empty)
' <<<"$input" 2>/dev/null | head -1)"
cwd="$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null)"
[[ -z "$cmd" ]] && exit 0

# Only git commit (allow `git -C dir commit`, chained commands; ignore commit-tree etc.)
grep -qE '(^|[;&|({[:space:]])git([[:space:]]+-[cC][[:space:]]+[^[:space:]]+)*[[:space:]]+commit([[:space:]]|$)' <<<"$cmd" || exit 0

# Resolve the directory the commit runs in: `git -C <dir>` > leading `cd <dir> &&` > hook cwd
dir="${cwd:-$PWD}"
if [[ "$cmd" =~ git[[:space:]]+-C[[:space:]]+(\"[^\"]+\"|\'[^\']+\'|[^[:space:]]+) ]]; then
  d="${BASH_REMATCH[1]}"; d="${d#[\"\']}"; d="${d%[\"\']}"
elif [[ "$cmd" =~ ^[[:space:]]*cd[[:space:]]+(\"[^\"]+\"|\'[^\']+\'|[^[:space:];&]+) ]]; then
  d="${BASH_REMATCH[1]}"; d="${d#[\"\']}"; d="${d%[\"\']}"
fi
if [[ -n "${d:-}" ]]; then
  d="${d/#\~/$HOME}"
  [[ "$d" = /* ]] && dir="$d" || dir="$dir/$d"
fi

root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || exit 0
origin="$(git -C "$root" remote get-url origin 2>/dev/null)"
grep -qiE 'github\.com[:/]alaska-' <<<"$origin" || exit 0

deny() {
  local reason="$1"
  if [[ "$agent" == copilot ]]; then
    jq -cn --arg r "$reason" '{permissionDecision:"deny", permissionDecisionReason:$r}'
  else
    jq -cn --arg r "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse", permissionDecision:"deny", permissionDecisionReason:$r}}'
  fi
  exit 0
}

localrc="${AQUA_LOCALRC:-$HOME/.localrc}"
[[ -r "$localrc" ]] || deny "Aqua pre-commit scan: $localrc not found (defines aqua_scan). Set AQUA_PRECOMMIT=off to bypass."

# Dockerfile present? (same discovery as aqua_scan) — otherwise skip
dockerfile="$(zsh -c 'source "$1" >/dev/null 2>&1; _aqua_find_dockerfile "$2" 2>/dev/null' _ "$localrc" "$root")"
[[ -z "$dockerfile" ]] && exit 0

# Cache key = HEAD + tracked changes + untracked files (all of it is in the build context)
key="$( {
  git -C "$root" rev-parse HEAD 2>/dev/null
  git -C "$root" diff HEAD --binary 2>/dev/null
  git -C "$root" ls-files -o --exclude-standard -z 2>/dev/null | (cd "$root" && xargs -0 shasum 2>/dev/null)
} | shasum | cut -c1-40)"
cache="$HOME/.cache/aqua-scan/passed"
mkdir -p "$cache"
[[ -f "$cache/$key" ]] && exit 0

log="$(mktemp -t aqua-precommit)"
zsh -c 'source "$1" >/dev/null 2>&1; aqua_scan "$2"' _ "$localrc" "$root" >"$log" 2>&1
rc=$?

summary="$(grep -E '^(==> (Build failed|Reports|Exit code)|Disallowed:|No Aqua|No Dockerfile|az token)' "$log" | tail -6)"
if [[ $rc -eq 0 ]]; then
  printf '%s\n%s\n' "$root" "$summary" >"$cache/$key"
  rm -f "$log"
  exit 0
fi

repo="$(basename "$origin" .git)"
deny "Aqua pre-commit scan FAILED for ${repo:-${root##*/}} (exit $rc, Dockerfile: ${dockerfile#$root/}). Do not commit until the image passes; fix the findings or ask the user.
$summary
Full log: $log"
