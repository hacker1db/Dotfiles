#!/bin/sh
# Scans staged changes with GitGuardian using the personal account only, and only for repos whose
# origin is a personal owner. Every other repo (including work remotes) is skipped, so work code is
# never sent to the personal workspace. It never falls back to the machine's default (work) login.
# Override the owner match with GITGUARDIAN_PERSONAL_REMOTES (an extended regex).
#
# The personal API key is read from 1Password. When OP_SERVICE_ACCOUNT_TOKEN is set (exported by
# ~/.localrc on headless machines), the Automation vault service account is used with biometric
# unlock disabled. When it is
# not set, op uses the desktop app integration so you approve the read with Touch ID; the account
# is pinned to GITGUARDIAN_PERSONAL_OP_ACCOUNT (default my.1password.com) so it never reads from a
# work account. Override the item with GITGUARDIAN_PERSONAL_OP_REF.
# A name-based reference (op://Automation/GG Scan Token/credential) costs the service account
# 3 API requests per read; an ID-based one (op://<vault-id>/<item-id>/credential) costs 1, which
# matters when the account's request quota is tight. A rate-limited read is reported as such.

personal='github\.com[:/](hacker1db|zerobitconsulting)/|^git@(github-hacker1db|hb1):'
origin=$(git remote get-url origin 2>/dev/null) || exit 0
printf '%s\n' "$origin" | grep -qiE "${GITGUARDIAN_PERSONAL_REMOTES:-$personal}" || exit 0

command -v ggshield >/dev/null 2>&1 || {
	echo "ggshield not found; install it with: brew install gitguardian/tap/ggshield" >&2
	exit 1
}

blocked() {
	cat >&2 <<MSG
$1
The GitGuardian pre-commit hook reads your personal API key (scope "scan") from 1Password:
  ${ref}
using the Automation vault service account when OP_SERVICE_ACCOUNT_TOKEN is set, otherwise the
1Password desktop app (account ${account}; enable Settings > Developer > Integrate with 1Password CLI).
Set GITGUARDIAN_PERSONAL_OP_REF to use a different item. The commit is blocked until then.
MSG
	exit 1
}

account="${GITGUARDIAN_PERSONAL_OP_ACCOUNT:-my.1password.com}"
ref="${GITGUARDIAN_PERSONAL_OP_REF:-op://Automation/GG Scan Token/credential}"
case $ref in
	op://*\?*) blocked "GITGUARDIAN_PERSONAL_OP_REF must not contain query parameters." ;;
	op://*) ;;
	*) blocked "GITGUARDIAN_PERSONAL_OP_REF must be an op:// reference." ;;
esac
command -v op >/dev/null 2>&1 || blocked "1Password CLI (op) not found; install it with: brew install 1password-cli"
if [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
	# op's stderr goes to a private temp file so it can be classified; it is never echoed raw.
	errfile=$(mktemp "${TMPDIR:-/tmp}/ggshield-op.XXXXXX") || blocked "Could not create a temporary file."
	trap 'rm -f "$errfile"' EXIT
	trap 'exit 1' HUP INT TERM
	key=$(OP_BIOMETRIC_UNLOCK_ENABLED=false op read --no-newline "$ref" </dev/null 2>"$errfile") || key=""
	if [ -z "$key" ] && grep -qiE 'too many requests|rate[- ]limit' "$errfile"; then
		retry=$(grep -ioE '(try again|retry) (in|after) [0-9]+ *[a-z]+' "$errfile" | head -n 1)
		blocked "The 1Password service account is rate-limited (too many requests).
${retry:+1Password says: $retry. }Wait for the quota to reset, then commit again."
	fi
	rm -f "$errfile"
	trap - EXIT HUP INT TERM
else
	# No service account on this machine: prompt for approval through the 1Password desktop app.
	echo "Requesting the GitGuardian key from 1Password; approve the prompt to continue." >&2
	key=$(op read --no-newline --account "$account" "$ref" </dev/null) || key=""
fi
[ -n "$key" ] || blocked "Could not read the GitGuardian key from 1Password."

# Only op sees the service-account token; ggshield gets just the GitGuardian key.
exec env -u OP_SERVICE_ACCOUNT_TOKEN GITGUARDIAN_API_KEY="$key" \
	GITGUARDIAN_INSTANCE=https://dashboard.gitguardian.com ggshield secret scan pre-commit "$@"
