[core]
    sshCommand = ~/.dotfiles/main/bin/git-agent-ssh
    hooksPath = ~/.dotfiles/main/git/templates/hooks
[gpg]
    format = ssh
[gpg "ssh"]
    program = ~/.dotfiles/main/bin/git-agent-sign
    defaultKeyCommand = sh -c ~/.dotfiles/main/bin/git-agent-signing-key
    allowedSignersFile = ~/.ssh/allowed_signers
[commit]
    gpgsign = true

[url "ssh://git@github.com/"]
    insteadOf = https://github.com/
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
[url "git@github-hacker1db:hacker1db/"]
    insteadOf = git@github.com:hacker1db/
[url "git@hb1:zerobitconsulting/"]
    insteadOf = git@github.com:zerobitconsulting/
    insteadOf = https://github.com/zerobitconsulting/

[agentkey "hb1"]
    title = Github personal
[agentkey "github-hacker1db"]
    title = Github personal
[agentkey "6212228+hacker1db@users.noreply.github.com"]
    title = Github personal
[agentkey "hacker1db@hacker1db.dev"]
    title = Github personal

# One identity for every repository; included after ~/.gitconfig-local, so it wins.
[user]
    name = hacker1db
    email = 6212228+hacker1db@users.noreply.github.com
