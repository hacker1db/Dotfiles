{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "markdownlint": {
      "command": ["markdownlint-language-server", "--stdio"],
      "extensions": [".md"]
    },
    "marksman": {
      "command": ["marksman", "server"],
      "extensions": [".md"]
    },
    "custom-lsp": {
      "command": ["custom-lsp-server", "--stdio"],
      "extensions": [".custom"]
    }
  }
}

