Include ~/.ssh/config.local
Include ~/.ssh/config-accounts

Host github.com
	HostName ssh.github.com
	Port 443
	HostKeyAlias github.com
	User git

Host stronghold
    HostName stronghold-2.local

Host aiserver
    # Lend the Mac's 1Password agent so no key ever lives on the server
    ForwardAgent yes
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
