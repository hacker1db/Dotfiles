Include ~/.ssh/config-accounts

Host github.com
	HostName ssh.github.com
	Port 443
	HostKeyAlias github.com
	User git

Host stronghold
    HostName stronghold-2.local

Host stronghold stronghold-2.local
    User hacker1db

Host aiserver
    HostName 192.168.1.157

Host aiserver 192.168.1.157
    User aiserver
    # Lend the Mac's 1Password agent so no key ever lives on the server
    ForwardAgent yes
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host stronghold stronghold-2.local aiserver 192.168.1.157
    LocalForward 3000 localhost:3000
    LocalForward 3001 localhost:3001
    LocalForward 5173 localhost:5173
    LocalForward 8000 localhost:8000
    LocalForward 8080 localhost:8080
    LocalForward 8888 localhost:8888
