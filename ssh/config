Include ~/.ssh/config.local

Host github.com
	HostName ssh.github.com
	Port 443
	HostKeyAlias github.com
	User git

Host stronghold
    HostName stronghold-2.local

# One identity per machine, held only in memory: bin/ssh-key-from-vault loads it
# from 1Password into this agent. No private key file exists on disk.
Host *
    IdentityAgent ~/.ssh/agent.sock
