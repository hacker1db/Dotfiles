Include ~/.ssh/config.local

Host github.com
	HostName ssh.github.com
	Port 443
	HostKeyAlias github.com
	User git

Host stronghold
    HostName stronghold-2.local

# One identity per machine, installed from 1Password by bin/ssh-key-from-vault
Host *
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    IdentityAgent none
