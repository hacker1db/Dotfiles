{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${DOTFILES:-$HOME/Developer/dotfiles}/bin/agent-secret-scan\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${DOTFILES:-$HOME/Developer/dotfiles}/bin/agent-secret-scan\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${DOTFILES:-$HOME/Developer/dotfiles}/bin/agent-secret-scan\""
          }
        ]
      }
    ]
  }
}
