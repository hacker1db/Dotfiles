{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "sh \"${DOTFILES:-$HOME/Developer/dotfiles}/bin/agent-secret-scan\"",
        "cwd": ".",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "sh \"${DOTFILES:-$HOME/Developer/dotfiles}/bin/agent-secret-scan\"",
        "cwd": ".",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "sh \"${DOTFILES:-$HOME/Developer/dotfiles}/bin/agent-secret-scan\"",
        "cwd": ".",
        "timeout": 30
      }
    ]
  }
}
